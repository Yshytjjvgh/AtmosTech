<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cytron_robot</name>
  <version>1.0.0</version>
  <description>
    Plug-and-play ROS2 package for a differential drive robot using
    Cytron motor driver + RPLidar A1 on Raspberry Pi.
    Supports SLAM mapping and Nav2 autonomous navigation.
  </description>
  <maintainer email="robot@example.com">Sujal</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rplidar_ros</depend>
  <depend>slam_toolbox</depend>
  <depend>nav2_bringup</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>

  <exec_depend>python3-RPi.GPIO</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
